# Lagos Life — Secret Lodge Mod: Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local — it is in .gitignore.

# ── Supabase ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Paystack ──────────────────────────────────────────────────────────────
# Secret key — server-side only, NEVER expose to the browser
PAYSTACK_SECRET_KEY=sk_live_...
# Public key — safe to use client-side (e.g. Paystack Inline JS)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_...

# ── App ───────────────────────────────────────────────────────────────────
# Your deployed Netlify URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-lodge.netlify.app

# ── Security ──────────────────────────────────────────────────────────────
# Random secret used to salt IP address hashing — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=change-this-to-a-64-char-random-hex-string

# ── Email (Resend) ────────────────────────────────────────────────────────
# https://resend.com — free tier: 100 emails/day
RESEND_API_KEY=re_...
EMAIL_FROM=lodge@yourdomain.com
