{
  "manifest_version": 3,
  "name": "Lagos Life — Secret Lodge Mod",
  "version": "1.0.0",
  "description": "A secret society mod for Lagos Life. Requires a valid Lodge license.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://lagoslife.app/*",
    "https://your-netlify-app.netlify.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://lagoslife.app/*"],
      "js": ["injector/loader.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Lodge Mod Settings",
    "default_popup": "popup/index.html"
  }
}
